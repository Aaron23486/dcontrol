{
  "name": "@cedi/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "API REST de CEDI Control (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && tsx scripts/db-app-user.ts",
    "db:seed": "tsx prisma/seed.ts",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "create-admin": "tsx scripts/users.ts create --role ADMIN",
    "users": "tsx scripts/users.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "e2e:prepare": "tsx scripts/e2e-prepare.ts"
  },
  "dependencies": {
    "@cedi/shared": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "prisma": "~7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.13.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.0",
    "unplugin-swc": "^2.0.0"
  }
}
