# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.
# Producción: genera secretos nuevos (la API se niega a arrancar con los de ejemplo) y no
# reutilices los de desarrollo ni guardes el .env en carpetas sincronizadas (OneDrive, etc.).

# --- Base de datos (docker-compose) ---
# Dueño de las tablas: aplica migraciones y crea el usuario de la API. La API no lo usa.
POSTGRES_USER=cedi
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=cedi
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
API_PORT=3000
# Usuario sin privilegios con que opera la API (ADR 0012). `npm run db:deploy` lo crea con este
# nombre y contraseña (contraseña de 16+ caracteres; usa letras, números, - y _ para la URL).
DATABASE_URL=postgresql://cedi_api:cambia-esta-contrasena-api@localhost:5432/cedi
# El dueño de las tablas: solo para migraciones (npm run db:deploy / db:migrate).
MIGRATION_DATABASE_URL=postgresql://cedi:cambia-esta-contrasena@localhost:5432/cedi
# Base exclusiva para pruebas de integración (se borra en cada ejecución).
DATABASE_URL_TEST=postgresql://cedi:cambia-esta-contrasena@localhost:5432/cedi_test
# Secreto para firmar la sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión en horas (un turno).
SESSION_TTL_HOURS=12
# Origen permitido por CORS (la web).
WEB_ORIGIN=http://localhost:5173
# Zona horaria del CEDI, para derivar la fecha de cada visita (formato IANA).
CEDI_TIMEZONE=America/Mexico_City
# Intentos de login permitidos por minuto y por IP.
LOGIN_RATE_LIMIT_PER_MINUTE=5
# Peticiones por minuto a toda la API, por usuario o por IP sin sesión (SEC-07, ADR 0014).
API_RATE_LIMIT_PER_MINUTE=300
# Bloqueo temporal de un correo tras N intentos fallidos seguidos (SEC-05, ADR 0013).
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_LOCKOUT_MINUTES=15
# Alerta en el log (evento security.alert) con N logins fallidos en 10 minutos (SEC-04).
SECURITY_ALERT_FAILED_LOGINS=20

# --- create-admin / users create --role ADMIN (opcional; si faltan, el script los pregunta) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Pruebas e2e (opcional) ---
# Navegador para Playwright: vacío = Chromium de Playwright; "chrome" o "msedge" = el instalado.
E2E_BROWSER_CHANNEL=

# --- Producción (ver README y docs/decisions/0010-despliegue.md) ---
# Carpeta con la web compilada que sirve la API (la imagen Docker ya la define).
WEB_DIST_DIR=
# true detrás de un proxy con HTTPS (IP real del cliente y cookie Secure).
TRUST_PROXY=false
# Puerto publicado por docker-compose.prod.yml.
APP_PORT=8080
# Usuario sin privilegios de la API en docker-compose.prod.yml (ADR 0012). Contraseña de 16+
# caracteres con letras, números, - y _ (va dentro de la URL de conexión).
APP_DB_USER=cedi_api
APP_DB_PASSWORD=
