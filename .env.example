# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.

# --- Base de datos (docker-compose) ---
POSTGRES_USER=cedi
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=cedi
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://cedi:cambia-esta-contrasena@localhost:5432/cedi
# Base exclusiva para pruebas de integración (se borra en cada ejecución).
DATABASE_URL_TEST=postgresql://cedi:cambia-esta-contrasena@localhost:5432/cedi_test
# Secreto para firmar la sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión en horas (un turno).
SESSION_TTL_HOURS=12
# Origen permitido por CORS (la web).
WEB_ORIGIN=http://localhost:5173
# Zona horaria del CEDI, para derivar la fecha de cada visita (formato IANA).
CEDI_TIMEZONE=America/Mexico_City
# Intentos de login permitidos por minuto y por IP.
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- create-admin / users create --role ADMIN (opcional; si faltan, el script los pregunta) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Pruebas e2e (opcional) ---
# Navegador para Playwright: vacío = Chromium de Playwright; "chrome" o "msedge" = el instalado.
E2E_BROWSER_CHANNEL=

# --- Producción (ver README y docs/decisions/0010-despliegue.md) ---
# Carpeta con la web compilada que sirve la API (la imagen Docker ya la define).
WEB_DIST_DIR=
# true detrás de un proxy con HTTPS (IP real del cliente y cookie Secure).
TRUST_PROXY=false
# Puerto publicado por docker-compose.prod.yml.
APP_PORT=8080
