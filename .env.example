# Copy this file to .env and replace the values. Never commit .env.
# Production: generate new secrets (the API refuses to start with the example ones), do not
# reuse the development ones and do not keep .env in synced folders (OneDrive and similar).

# --- Database (docker-compose) ---
# Table owner: applies migrations and creates the API user. The API does not use it.
POSTGRES_USER=cedi
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=cedi
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
API_PORT=3000
# Unprivileged user the API runs as (ADR 0012). `npm run db:deploy` creates it with this name
# and password (16+ characters; use letters, digits, - and _ so it fits in the URL).
DATABASE_URL=postgresql://cedi_api:cambia-esta-contrasena-api@localhost:5432/cedi
# The table owner: only for migrations (npm run db:deploy / db:migrate).
MIGRATION_DATABASE_URL=postgresql://cedi:cambia-esta-contrasena@localhost:5432/cedi
# Dedicated database for integration and E2E tests (it is wiped on every run).
DATABASE_URL_TEST=postgresql://cedi:cambia-esta-contrasena@localhost:5432/cedi_test
# Secret that signs the session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session length in hours (one shift).
SESSION_TTL_HOURS=12
# Origin allowed by CORS (the web app).
WEB_ORIGIN=http://localhost:5173
# The CEDI's time zone (IANA format), used to decide which day a visit belongs to.
CEDI_TIMEZONE=America/Mexico_City
# Sign-in attempts allowed per minute and per IP.
LOGIN_RATE_LIMIT_PER_MINUTE=5
# Requests per minute to the whole API, per user or per IP without a session (ADR 0014).
API_RATE_LIMIT_PER_MINUTE=300
# Temporary lockout of an email after N consecutive failed attempts (ADR 0013).
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_LOCKOUT_MINUTES=15
# Log alert (security.alert event) after N failed sign-ins within 10 minutes (ADR 0013).
SECURITY_ALERT_FAILED_LOGINS=20

# --- create-admin / users create --role ADMIN (optional; the script asks if they are empty) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- E2E tests (optional) ---
# Browser for Playwright: empty = Playwright's Chromium; "chrome" or "msedge" = the installed one.
E2E_BROWSER_CHANNEL=

# --- Production (see the README and docs/decisions/0010-single-container-deployment.md) ---
# Folder with the built web app that the API serves (the Docker image already sets it).
WEB_DIST_DIR=
# true behind an HTTPS proxy (real client IP and Secure cookie).
TRUST_PROXY=false
# Port published by docker-compose.prod.yml.
APP_PORT=8080
# Unprivileged API user in docker-compose.prod.yml (ADR 0012). Password with 16+ characters,
# letters, digits, - and _ (it goes inside the connection URL).
APP_DB_USER=cedi_api
APP_DB_PASSWORD=
