{
  "name": "cedi-control",
  "version": "0.1.0",
  "private": true,
  "description": "Control de ingreso y salida de personal externo en un CEDI",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "npm run build -w @cedi/shared && npm run prisma:generate -w @cedi/api",
    "dev": "npm run build -w @cedi/shared && concurrently -k -n api,web -c blue,green \"npm run dev -w @cedi/api\" \"npm run dev -w @cedi/web\"",
    "build": "npm run build -w @cedi/shared && npm run build -w @cedi/api && npm run build -w @cedi/web",
    "start": "npm run start -w @cedi/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @cedi/api",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @cedi/api",
    "db:deploy": "npm run db:deploy -w @cedi/api",
    "db:seed": "npm run db:seed -w @cedi/api",
    "create-admin": "npm run create-admin -w @cedi/api",
    "users": "npm run users -w @cedi/api --",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "screenshots": "node -e \"process.env.SCREENSHOTS=1;require('child_process').execSync('npx playwright test --config e2e/playwright.config.ts',{stdio:'inherit',env:process.env})\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "prettier": "^3.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
